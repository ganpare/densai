# 環境変数のサンプルファイル
# 実際に使用する場合は、このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# データベース接続URL
# Docker環境では docker-compose.yml で自動設定されます
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bond_inquiry_db

# セッション暗号化キー
# 本番環境では必ず強力なランダム文字列に変更してください
# 生成方法: openssl rand -base64 32
SESSION_SECRET=your-very-secure-random-secret-key-here

# アプリケーション設定
NODE_ENV=production
PORT=5000

# PostgreSQL設定（docker-compose.yml内で使用）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bond_inquiry_db
